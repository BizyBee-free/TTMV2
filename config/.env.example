# =============================================================================
# BeeTrade — mẫu .env (mặc định: HMM nến 15m)
# Sao chép:  copy config/.env.example  →  .env  (thư mục gốc project)
# Thứ 2 đầu tuần: điền DNSE_* , (tuỳ chọn) MIN_BALANCE, token giao dịch, Telegram.
# =============================================================================

# --- Bắt buộc DNSE ---
DNSE_API_KEY=your-api-key-here
DNSE_API_SECRET=your-api-secret-here
DNSE_ACCOUNT_NO=your-account-number

# Trading token (sau khi đổi OTP trên email → dán token vào đây HOẶC dùng file bên dưới)
# Lấy token: python scripts/request_dnse_trading_token.py  (gửi OTP email → nhập mã → in dòng DNSE_TRADING_TOKEN=)
# Để trống nếu chỉ paper / hoặc nhập OTP khi chạy console.
DNSE_TRADING_TOKEN=
# DNSE_TRADING_TOKEN_FILE=config/secrets/dnse_trading_token.txt

# API (mặc định production)
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn/v1/stream
# OpenAPI V2: thử /positions trước; 404 thì fallback /deals (tài liệu DNSE)
# DNSE_POSITIONS_FALLBACK_TO_DEALS=true
WS_ENCODING=msgpack
# Market WS: mặc định KHÔNG gắn sessionId vào subscribe (chỉ auth). Bật true nếu tài liệu DNSE yêu cầu.
# DNSE_WS_SUBSCRIBE_USE_SESSION_ID=false
# DNSE_WS_BOARD_ID=G1
# Cổ phiếu HOSE (paper_test TTM): DNSE_WS_BOARD_ID=G1,AL — tick/top_price trên cả G1 và AL
# DNSE_WS_OHLC_BOARD_IN_CHANNEL=false   # client dùng ohlc.{tf}.msgpack (openapi-sdk); flag chỉ tương thích API
# Khi WS không đẩy nến: tổng hợp OHLC từ trade (synth_trade). Tắt nếu chỉ tin nến từ server.
# DNSE_OHLC_SYNTH_FROM_TRADES=true
# DNSE_OHLC_SYNTH_STOP_WHEN_WS_OHLC=true
# Debug pipeline WS: RAW_WS → DECODED → SUB OK → MARKET DATA OK → TICK(trade). Hoặc: paper_test --debug-ws-pipeline
# DNSE_WS_PIPELINE_DEBUG=false
# Sau N giây: assert có ít nhất một dispatch market (0 = tắt). Hoặc: paper_test --ws-assert-market-sec 90
# DNSE_WS_PIPELINE_ASSERT_MARKET_SEC=0

# --- Chiến lược: HMM 15m (mặc định) | TTM (Trapped Trader) | MCMC (paper_test) ---
STRATEGY_ALGO=HMM
# STRATEGY_ALGO=TTM

# Live 15m (scripts/hmm_live.py / hmm_live_session.py): mọi log terminal (tee) →
#   data/debug/hmm_live_YYYYMMDD.log  (HMM và TTM đều ghi cùng file theo ngày)
# (cùng HMM_SYMBOL, HMM_USE_BASIS, HMM_INDEX_SYMBOL, HMM_USE_OPEN_INTEREST như HMM)

# Paper = true an toàn; trước khi live thật đặt false (và điền token + MIN_BALANCE).
PAPER_MODE=true

# Symbol OHLC 15m cho HMM (VN30F1M = front-month; DataFetcher có thể proxy VN30 nếu thiếu dữ liệu)
HMM_SYMBOL=VN30F1M
# Khi true: lần đầu tạo BeeTradeClient, gọi DNSE /instruments lọc mã 41I1Gxxxx và đối chiếu heuristic lịch (thứ Năm tuần 3).
# Hai nguồn phải khớp mới cập nhật SYMBOL_MAP['VN30F1M']['trade_symbol']; lệch → thoát process. Mặc định false (pytest/offline).
# VN30_AUTO_RESOLVE_TRADE_SYMBOL=false
# Mã KRX 9 ký tự cố định (live + paper): ưu tiên hơn auto-resolve, không gọi /instruments. Ví dụ tháng đáo hạn 5/2026:
# VN30_F1M_TRADE_SYMBOL=41I1G5000
# Basis = close(future) − close(index); cần fetch thêm OHLC index cùng resolution
HMM_USE_BASIS=true
HMM_INDEX_SYMBOL=VN30
# Phase 2: OI từ GET /price/{symbol}/secdef (openInterestQuantity) + cache data/cache/oi/
HMM_USE_OPEN_INTEREST=false

# HMM live (15m)
HMM_LIVE_TRAIN_WINDOW_BARS=1000
HMM_LIVE_REFIT_EVERY=5
HMM_LIVE_K_STATES=3
HMM_LIVE_CONFIDENCE=0.65
HMM_LIVE_WARMUP_BARS=30
# HMM_LIVE_DEBUG_TRACE=true
# NOTE: runtime reads only `.env` at project root; set this flag in `.env` (not this example file).

# Kill switch & DNSE
# MIN_BALANCE=60000000
DNSE_HTTP_TIMEOUT_SEC=30
DNSE_API_FAIL_HALT_THRESHOLD=3
RECONCILE_BALANCE_EPS_VND=50000
DERIVATIVE_FEE_RATE=0

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Risk chung
MAX_DAILY_LOSS_PCT=2.0
MAX_ORDERS_PER_MINUTE=10
STOPLOSS_DEFAULT_PCT=3.0

# Telegram (bật khi cần notify + /pause)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Operations / control layer (TTM live; không đổi logic tín hiệu) ---
OPS_ENABLED=false
CONTROL_ENABLED=true
ORDER_MONITOR_ENABLED=true
HEALTH_MONITOR_ENABLED=true
OTP_TELEGRAM_ENABLED=false
CONTROL_TRADE_ENABLED_DEFAULT=false
DATA_STALE_SEC=10
BAR_STALE_SEC=70
DECISION_STALE_SEC=90
ORDER_ACK_TIMEOUT_SEC=5
ORDER_FILL_TIMEOUT_SEC=10
PAUSE_ON_DATA_STALE=true
PAUSE_ON_ORDER_TIMEOUT=true
AUTO_FLATTEN_ON_CRITICAL=false

# --- MCMC (chỉ khi STRATEGY_ALGO=MCMC) ---
# MCMC_DERIVATIVE_SYMBOL=VN30F2506
# MCMC_CONFIDENCE_THRESHOLD=0.75
# MCMC_NUM_PATHS=10000
# MCMC_ROLLING_WINDOW=50
# MCMC_MH_ITERATIONS=1000
# MCMC_MH_BURNIN=500
# MCMC_FORCE_CLOSE_MINUTE=865
# MCMC_POSITION_SIZE=1
# MCMC_COOLDOWN_TICKS=10
# Exit rules (points / Markov states; see src/strategies/exit_rules.py)
# MCMC_STOP_LOSS_POINTS=2.5
# MCMC_TAKE_PROFIT_POINTS=5.0
# MCMC_MAX_BARS_IN_TRADE=8
# MCMC_STATE_FLIP_THRESHOLD=0.75
# MCMC_EXPECTED_RETURN_THRESHOLD=0.1
# MCMC_TRANSACTION_COST_POINTS=0.2
# MCMC_EXIT_BULLISH_STATES=1
# MCMC_EXIT_BEARISH_STATES=0
